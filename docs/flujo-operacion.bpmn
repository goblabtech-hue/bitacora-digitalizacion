    <bpmndi:BPMNShape id="t_acuse_di" bpmnElement="t_acuse"><dc:Bounds x="440" y="310" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_validar_di" bpmnElement="t_validar"><dc:Bounds x="605" y="310" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g_coincide_di" bpmnElement="g_coincide" isMarkerVisible="true"><dc:Bounds x="810" y="325" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="775" y="291" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_diferencia_di" bpmnElement="t_diferencia"><dc:Bounds x="935" y="400" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g_union1_di" bpmnElement="g_union1" isMarkerVisible="true"><dc:Bounds x="1140" y="325" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g_sede_di" bpmnElement="g_sede" isMarkerVisible="true"><dc:Bounds x="1305" y="325" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_enviar_di" bpmnElement="t_enviar"><dc:Bounds x="1430" y="222" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_recibir_di" bpmnElement="t_recibir"><dc:Bounds x="1595" y="222" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g_union2_di" bpmnElement="g_union2" isMarkerVisible="true"><dc:Bounds x="1800" y="325" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_asignar_di" bpmnElement="t_asignar"><dc:Bounds x="1925" y="310" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_descoser_di" bpmnElement="t_descoser"><dc:Bounds x="2090" y="580" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g_fojas_di" bpmnElement="g_fojas" isMarkerVisible="true"><dc:Bounds x="2295" y="595" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2260" y="561" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_incidencia_di" bpmnElement="t_incidencia"><dc:Bounds x="2255" y="790" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_insertos_di" bpmnElement="t_insertos"><dc:Bounds x="2420" y="580" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_escanear_di" bpmnElement="t_escanear"><dc:Bounds x="2585" y="580" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g_completo_di" bpmnElement="g_completo" isMarkerVisible="true"><dc:Bounds x="2790" y="595" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2755" y="561" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_pdf_di" bpmnElement="t_pdf"><dc:Bounds x="2915" y="580" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_recoser_di" bpmnElement="t_recoser"><dc:Bounds x="3080" y="580" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g_lote_di" bpmnElement="g_lote" isMarkerVisible="true"><dc:Bounds x="3285" y="325" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="3250" y="291" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="fin_carpeta_di" bpmnElement="fin_carpeta"><dc:Bounds x="3292" y="422" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_cotejar_di" bpmnElement="t_cotejar"><dc:Bounds x="3410" y="310" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_devolver_di" bpmnElement="t_devolver"><dc:Bounds x="3575" y="310" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="fin_di" bpmnElement="fin"><dc:Bounds x="3787" y="332" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ini_sol_di" bpmnElement="ini_sol"><dc:Bounds x="322" y="812" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_sol_di" bpmnElement="t_sol"><dc:Bounds x="440" y="790" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="fin_sol_di" bpmnElement="fin_sol"><dc:Bounds x="652" y="812" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a1_di" bpmnElement="a1"><dc:Bounds x="1590" y="548" width="230" height="52" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a2_di" bpmnElement="a2"><dc:Bounds x="805" y="935" width="330" height="22" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="193" y="350" /><di:waypoint x="275" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="405" y="350" /><di:waypoint x="440" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="570" y="350" /><di:waypoint x="605" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="735" y="350" /><di:waypoint x="810" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="860" y="350" /><di:waypoint x="1140" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="835" y="375" /><di:waypoint x="835" y="440" /><di:waypoint x="935" y="440" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1065" y="440" /><di:waypoint x="1165" y="440" /><di:waypoint x="1165" y="375" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="1190" y="350" /><di:waypoint x="1305" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1355" y="350" /><di:waypoint x="1800" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1330" y="325" /><di:waypoint x="1330" y="262" /><di:waypoint x="1430" y="262" /></bpmndi:BPMNEdge>
